---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StageLoop from '../components/StageLoop.astro';
import { lines, site } from '../site';
import { curriculum } from '../data/curriculum';

const propositions = (await getCollection('propositions')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);

const total = propositions.length;
const first = propositions[0];
const ids = propositions.map((entry) => entry.data.id);

// 趣味数学的规模看课程体系（大类 → 章节 → 主题），不看已写好的 Markdown 数量。
const funTopics = curriculum.reduce(
  (sum, section) =>
    sum + section.chapters.reduce((n, chapter) => n + chapter.topics.length, 0),
  0,
);

// 首页只做门户：三条内容线各自成栏目，点进去再看题。
// 九章 / 孙子按命题计数，趣味数学按课程主题计数。
const modules = lines.map((line) => ({
  ...line,
  count:
    line.slug === 'fun'
      ? funTopics
      : propositions.filter((entry) => entry.data.line === line.name).length,
  unit: line.slug === 'fun' ? '个主题' : '题',
}));

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title={site.name} full>
  <div class="mc-home">
    <section id="start" class="mc-hero" aria-labelledby="home-title">
      <div class="mc-hero__copy">
        <p class="mc-eyebrow">PUBLIC DOMAIN · 公版数学经典</p>
        <h1 id="home-title">算经<em>小课</em></h1>
        <p class="mc-hero__lead">
          古算书原题，白话拆解，动手作图。
        </p>
        <ul class="mc-hero__facts">
          <li><b>{total}</b><span>道古题</span></li>
          <li><b>{modules.length}</b><span>条内容线</span></li>
          <li><b>3</b><span>分钟一题</span></li>
        </ul>
        <div class="mc-hero__actions">
          <a class="mc-btn mc-btn--solid" href="#modules">选一条线开始</a>
          {first && <a class="mc-btn" href={`/propositions/${first.data.id}/`}>先做一题 →</a>}
        </div>
      </div>
      <div class="mc-hero__stage">
        <StageLoop />
      </div>
    </section>

    <section id="modules" class="mc-home-section" aria-labelledby="modules-title">
      <header class="mc-home-head">
        <p class="mc-eyebrow">THREE PATHS · 内容线</p>
        <h2 id="modules-title">三条线，<em>挑一条进</em></h2>
      </header>

      <ol class="mc-modgrid">
        {
          modules.map((line, index) => (
            <li>
              <a
                class:list={['mc-modcard', { 'is-soon': line.status === 'soon' }]}
                href={`/${line.slug}/`}
              >
                <span class="mc-modcard__no" aria-hidden="true">{pad(index + 1)}</span>
                <span class="mc-modcard__latin">{line.latin}</span>
                <h3>{line.name}</h3>
                <p>{line.summary}</p>
                <span class="mc-modcard__foot">
                  <span>{line.count > 0 ? `${line.count} ${line.unit}` : '筹备中'}</span>
                  <span class="mc-modcard__go">进入栏目 →</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="mc-homeprogress" data-progress data-ids={ids.join(',')}>
        <span class="mc-homeprogress__label">本机进度</span>
        <b><span data-progress-count>0</span> / {total}</b>
        <span
          class="mc-homeprogress__bar"
          role="progressbar"
          aria-label="本机做题进度"
          aria-valuemin="0"
          aria-valuemax={total}
          data-progress-bar
        >
          <i data-progress-fill></i>
        </span>
        <button type="button" class="mc-homeprogress__clear" data-progress-clear>清空</button>
      </div>
    </section>

    <section id="reading" class="mc-home-section" aria-labelledby="reading-title">
      <header class="mc-home-head">
        <p class="mc-eyebrow">HOW TO READ · 读法</p>
        <h2 id="reading-title">一题四步</h2>
      </header>

      <ol class="mc-howsteps">
        <li>
          <span class="mc-howsteps__no">01</span>
          <h3>原文</h3>
        </li>
        <li>
          <span class="mc-howsteps__no">02</span>
          <h3>白话</h3>
        </li>
        <li>
          <span class="mc-howsteps__no">03</span>
          <h3>动手</h3>
        </li>
        <li>
          <span class="mc-howsteps__no">04</span>
          <h3>练习</h3>
        </li>
      </ol>
    </section>

    <section id="about" class="mc-home-section mc-about" aria-labelledby="about-title">
      <div class="mc-about__head">
        <p class="mc-eyebrow">ABOUT · 关于</p>
        <h2 id="about-title">只用公有领域的古算书</h2>
      </div>
      <div class="mc-about__body">
        <p>
          底本只用公有领域古算书（维基文库、四库影印、archive.org），原文不改，不复制、不翻译现代出版物。
        </p>
        <p id="errata">
          不登录也能用，进度只存本机，不接广告与追踪。发现错误请走<a href={site.errataHref}>勘误入口</a>。
        </p>
        <p class="mc-about__links"><a href="/lab/">进实验台，自己拖一拖 →</a></p>
      </div>
    </section>
  </div>
</Base>

<script>
  import { readProgress, clearProgress } from '../scripts/progress';

  const panel = document.querySelector<HTMLElement>('[data-progress]');

  if (panel) {
    const ids = (panel.dataset.ids ?? '').split(',').filter(Boolean);
    const count = panel.querySelector<HTMLElement>('[data-progress-count]');
    const fill = panel.querySelector<HTMLElement>('[data-progress-fill]');
    const bar = panel.querySelector<HTMLElement>('[data-progress-bar]');
    const clear = panel.querySelector<HTMLButtonElement>('[data-progress-clear]');

    const render = () => {
      const progress = readProgress();
      const done = ids.filter((id) => progress[id]?.done).length;
      if (count) count.textContent = String(done);
      if (fill) fill.style.width = ids.length ? `${(done / ids.length) * 100}%` : '0%';
      if (bar) bar.setAttribute('aria-valuenow', String(done));
    };

    render();

    clear?.addEventListener('click', () => {
      if (!confirm('清空本机进度？只影响你自己的浏览器。')) return;
      clearProgress();
      render();
    });
  }
</script>

<style>
  .mc-home {
    padding-top: clamp(92px, 10vh, 120px);
  }

  /* 首页铺满视口宽度，页脚也一起放开（其他页面仍按 1120px 居中） */
  :global(.mc-html--home) :global(.mc-footer) {
    max-width: none;
  }

  /* ---------- 英雄区 ---------- */
  .mc-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: clamp(24px, 3vw, 56px);
    align-items: center;
    width: 100%;
    max-width: 1560px;
    margin-inline: auto;
    min-height: 0;
    padding-bottom: clamp(40px, 6vh, 72px);
  }

  /* 分隔线单独画，保证通栏（英雄区内容限宽 1560，线不限宽） */
  .mc-hero::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    border-bottom: 1px solid var(--mc-line);
  }

  .mc-hero h1 {
    margin: 0;
    font-family: var(--mc-serif);
    font-size: clamp(58px, 8vw, 150px);
    line-height: 1;
    letter-spacing: 0.06em;
    padding-left: 0.06em;
  }

  .mc-hero h1 em {
    font-style: normal;
    color: var(--mc-accent);
  }

  .mc-hero__lead {
    max-width: 30rem;
    margin: clamp(18px, 3vw, 30px) 0 0;
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.95;
    color: var(--mc-ink-soft);
    text-wrap: pretty;
  }

  .mc-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: clamp(22px, 3vw, 34px) 0 0;
    padding: 0;
    list-style: none;
  }

  .mc-hero__facts li {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  .mc-hero__facts b {
    font-family: var(--mc-serif);
    font-size: 26px;
    font-weight: 600;
    color: var(--mc-ink);
  }

  .mc-hero__facts span {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--mc-muted);
  }

  .mc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: clamp(24px, 3.6vw, 38px);
  }

  .mc-hero__actions .mc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mc-btn--solid {
    background: var(--mc-accent);
    border-color: var(--mc-accent);
    color: #08101f;
  }

  .mc-btn--solid:hover {
    background: transparent;
    color: var(--mc-accent);
  }

  .mc-hero__stage {
    height: clamp(380px, 54vh, 640px);
    padding: 12px 14px;
    border: 1px solid var(--mc-line);
    border-radius: 4px;
    background: var(--mc-panel);
  }

  /* ---------- 通用分段 ---------- */
  .mc-home-section {
    padding: clamp(56px, 9vh, 110px) 0;
    border-bottom: 1px solid var(--mc-line);
  }

  .mc-home-head {
    max-width: 46rem;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .mc-home-head h2 {
    margin: 0;
    font-family: var(--mc-serif);
    font-size: clamp(28px, 3.6vw, 44px);
    line-height: 1.25;
    letter-spacing: 0.03em;
  }

  .mc-home-head h2 em {
    font-style: normal;
    color: var(--mc-accent);
  }

  .mc-home-head p:last-child {
    margin: 14px 0 0;
    max-width: 38rem;
    font-size: 14px;
    line-height: 1.9;
    color: var(--mc-muted);
  }

  /* ---------- 三个栏目 ---------- */
  .mc-modgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mc-modcard {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 278px;
    padding: 26px 24px 22px;
    border: 1px solid var(--mc-line);
    border-radius: 4px;
    background: var(--mc-panel);
    color: inherit;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease, background 0.25s ease;
  }

  .mc-modcard:hover,
  .mc-modcard:focus-visible {
    border-color: var(--mc-line-strong);
    background: rgba(255, 255, 255, 0.055);
    transform: translateY(-3px);
  }

  .mc-modcard__no {
    position: absolute;
    top: 10px;
    right: 16px;
    font-family: var(--mc-serif);
    font-size: 76px;
    line-height: 1;
    color: var(--mc-ink);
    opacity: 0.07;
  }

  .mc-modcard__latin {
    font-size: 10px;
    letter-spacing: 0.34em;
    color: var(--mc-muted);
  }

  .mc-modcard h3 {
    margin: 14px 0 0;
    font-family: var(--mc-serif);
    font-size: clamp(26px, 2.4vw, 32px);
    letter-spacing: 0.06em;
  }

  .mc-modcard p {
    margin: 12px 0 26px;
    font-size: 13px;
    line-height: 1.85;
    color: var(--mc-ink-soft);
  }

  .mc-modcard__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--mc-line);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--mc-muted);
  }

  .mc-modcard__go {
    color: var(--mc-accent);
  }

  .mc-modcard.is-soon .mc-modcard__go {
    color: var(--mc-muted);
  }

  /* ---------- 本机进度 ---------- */
  .mc-homeprogress {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 22px;
    padding: 12px 16px;
    border: 1px solid var(--mc-line);
    border-radius: 4px;
    background: var(--mc-panel);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--mc-muted);
  }

  .mc-homeprogress b {
    font-weight: 500;
    color: var(--mc-ink);
  }

  .mc-homeprogress__bar {
    flex: 1;
    min-width: 120px;
    height: 4px;
    background: var(--mc-line);
    overflow: hidden;
  }

  .mc-homeprogress__bar i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--mc-accent);
    transition: width 0.3s ease;
  }

  .mc-homeprogress__clear {
    padding: 2px 0;
    border: 0;
    background: none;
    color: var(--mc-muted);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .mc-homeprogress__clear:hover {
    color: var(--mc-accent);
  }

  /* ---------- 读法 ---------- */
  /* 独立类名：global.css 里的 .mc-steps 是命题页的两列网格，首页不能复用，否则正文被挤成竖排。 */
  .mc-howsteps {
    display: flex;
    flex-wrap: wrap;
    gap: 16px clamp(28px, 4vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mc-howsteps li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mc-howsteps__no {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--mc-accent);
    border-radius: 50%;
    font-family: var(--mc-serif);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--mc-accent);
  }

  .mc-howsteps h3 {
    margin: 0;
    font-family: var(--mc-serif);
    font-size: 19px;
    letter-spacing: 0.1em;
  }

  /* ---------- 关于 ---------- */
  .mc-about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 72px);
    border-bottom: 0;
  }

  .mc-about h2 {
    margin: 0;
    font-family: var(--mc-serif);
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.35;
    letter-spacing: 0.04em;
  }

  .mc-about__body p {
    margin: 0 0 14px;
    max-width: 44rem;
    font-size: 13.5px;
    line-height: 1.95;
    color: var(--mc-ink-soft);
  }

  .mc-about__body a {
    color: var(--mc-accent);
  }

  .mc-about__links {
    margin-top: 20px !important;
  }

  /* ---------- 窄屏 ---------- */
  @media (max-width: 900px) {
    .mc-hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .mc-hero__stage {
      height: 340px;
      order: -1;
    }

    .mc-about {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .mc-home {
      padding-top: 92px;
    }

    .mc-hero__stage {
      height: 300px;
      padding: 8px 10px;
    }

    .mc-modcard {
      min-height: 240px;
    }
  }
</style>
