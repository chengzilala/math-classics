---
// 基础原语 02：坐标系。可拖点；mode 决定画点、直角三角形还是矩形。
interface Props {
  mode?: 'point' | 'triangle' | 'rect';
  snap?: number;
  maxX?: number;
  maxY?: number;
  startX?: number;
  startY?: number;
}

const {
  mode = 'point',
  snap = 0.5,
  maxX = 10,
  maxY = 10,
  startX = mode === 'triangle' ? 3 : mode === 'rect' ? 15 : 5,
  startY = mode === 'triangle' ? 4 : mode === 'rect' ? 16 : 5,
} = Astro.props;

const hint =
  mode === 'triangle'
    ? '拖动点，看直角边与斜边一起变'
    : mode === 'rect'
      ? '拖动点，看广、从与面积怎么变'
      : '点击或拖动，读取坐标';
---

<div
  class="mc-lab-board"
  data-coord-plane
  data-mode={mode}
  data-snap={snap}
  data-max-x={maxX}
  data-max-y={maxY}
  data-start-x={startX}
  data-start-y={startY}
>
  <svg viewBox="0 0 360 300" tabindex="0" role="application" aria-label={hint} data-svg>
    <g data-grid></g>
    <g data-shape></g>
    <circle class="mc-lab-dot" r="7" cx="0" cy="0" data-dot></circle>
  </svg>
  <p class="mc-lab-readout" data-readout aria-live="polite">{hint}</p>
</div>

<script>
  const NS = 'http://www.w3.org/2000/svg';

  const make = (tag: string, attrs: Record<string, string | number> = {}) => {
    const node = document.createElementNS(NS, tag);
    for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
    return node;
  };

  const fmt = (value: number) => String(Math.round(value * 100) / 100);

  document.querySelectorAll<HTMLElement>('[data-coord-plane]').forEach((root) => {
    const svg = root.querySelector<SVGSVGElement>('[data-svg]');
    const gridLayer = root.querySelector<SVGGElement>('[data-grid]');
    const shapeLayer = root.querySelector<SVGGElement>('[data-shape]');
    const dot = root.querySelector<SVGCircleElement>('[data-dot]');
    const readout = root.querySelector<HTMLElement>('[data-readout]');

    if (!svg || !gridLayer || !shapeLayer || !dot || !readout) return;

    const W = 360;
    const H = 300;
    const PAD_L = 34;
    const PAD_R = 12;
    const PAD_T = 12;
    const PAD_B = 28;
    const plotW = W - PAD_L - PAD_R;
    const plotH = H - PAD_T - PAD_B;

    const mode = root.dataset.mode ?? 'point';
    const snap = Number(root.dataset.snap ?? 0.5) || 0.5;
    const maxX = Number(root.dataset.maxX ?? 10) || 10;
    const maxY = Number(root.dataset.maxY ?? 10) || 10;

    const clamp = (value: number, min: number, max: number) =>
      Math.min(max, Math.max(min, value));

    const state = {
      x: clamp(Number(root.dataset.startX ?? 5), 0, maxX),
      y: clamp(Number(root.dataset.startY ?? 5), 0, maxY),
      dragging: false,
    };

    const screenX = (x: number) => PAD_L + (x / maxX) * plotW;
    const screenY = (y: number) => H - PAD_B - (y / maxY) * plotH;

    const gridStep = maxX <= 10 ? 1 : maxX <= 20 ? 2 : 5;
    const labelEvery = maxX <= 10 ? 5 : maxX <= 20 ? 5 : 10;

    // 网格与刻度
    for (let x = 0; x <= maxX + 0.001; x += gridStep) {
      const px = screenX(x);
      gridLayer.appendChild(
        make('line', {
          x1: px,
          y1: PAD_T,
          x2: px,
          y2: H - PAD_B,
          class: 'mc-lab-grid-line',
        }),
      );
      if (Math.abs(x / labelEvery - Math.round(x / labelEvery)) < 0.001) {
        gridLayer.appendChild(
          make('text', {
            x: px,
            y: H - PAD_B + 16,
            'text-anchor': 'middle',
            class: 'mc-lab-axis-label',
          }),
        ).textContent = String(x);
      }
    }

    for (let y = 0; y <= maxY + 0.001; y += gridStep) {
      const py = screenY(y);
      gridLayer.appendChild(
        make('line', {
          x1: PAD_L,
          y1: py,
          x2: W - PAD_R,
          y2: py,
          class: 'mc-lab-grid-line',
        }),
      );
      if (Math.abs(y / labelEvery - Math.round(y / labelEvery)) < 0.001) {
        gridLayer.appendChild(
          make('text', {
            x: PAD_L - 6,
            y: py + 3,
            'text-anchor': 'end',
            class: 'mc-lab-axis-label',
          }),
        ).textContent = String(y);
      }
    }

    gridLayer.appendChild(
      make('line', {
        x1: PAD_L,
        y1: PAD_T,
        x2: PAD_L,
        y2: H - PAD_B,
        class: 'mc-lab-axis',
      }),
    );
    gridLayer.appendChild(
      make('line', {
        x1: PAD_L,
        y1: H - PAD_B,
        x2: W - PAD_R,
        y2: H - PAD_B,
        class: 'mc-lab-axis',
      }),
    );

    const drawShape = () => {
      shapeLayer.replaceChildren();
      const px = screenX(state.x);
      const py = screenY(state.y);
      const originX = screenX(0);
      const originY = screenY(0);

      if (mode === 'triangle') {
        shapeLayer.appendChild(
          make('polygon', {
            points: `${originX},${originY} ${px},${originY} ${px},${py}`,
            class: 'mc-lab-shape',
          }),
        );
      } else if (mode === 'rect') {
        shapeLayer.appendChild(
          make('rect', {
            x: Math.min(originX, px),
            y: Math.min(originY, py),
            width: Math.abs(px - originX),
            height: Math.abs(py - originY),
            class: 'mc-lab-shape',
          }),
        );
      }
    };

    const render = (emit = false) => {
      dot.setAttribute('cx', String(screenX(state.x)));
      dot.setAttribute('cy', String(screenY(state.y)));
      drawShape();

      const x = Number(state.x.toFixed(2));
      const y = Number(state.y.toFixed(2));

      if (mode === 'triangle') {
        const c = Math.hypot(x, y);
        readout.innerHTML = `勾 <strong>${fmt(x)}</strong>，股 <strong>${fmt(y)}</strong>，弦 ≈ <strong>${c.toFixed(2)}</strong>`;
      } else if (mode === 'rect') {
        readout.innerHTML = `广 <strong>${fmt(x)}</strong>，从 <strong>${fmt(y)}</strong>，面积 <strong>${fmt(x * y)}</strong> 平方步`;
      } else {
        readout.innerHTML = `坐标（<strong>${fmt(x)}</strong>, <strong>${fmt(y)}</strong>）`;
      }

      if (emit) {
        root.dispatchEvent(
          new CustomEvent('mc:point', { detail: { x, y }, bubbles: true }),
        );
      }
    };

    const moveTo = (clientX: number, clientY: number) => {
      const rect = svg.getBoundingClientRect();
      const px = ((clientX - rect.left) / rect.width) * W;
      const py = ((clientY - rect.top) / rect.height) * H;

      const rawX = ((px - PAD_L) / plotW) * maxX;
      const rawY = ((H - PAD_B - py) / plotH) * maxY;

      state.x = clamp(Math.round(rawX / snap) * snap, 0, maxX);
      state.y = clamp(Math.round(rawY / snap) * snap, 0, maxY);
      render(true);
    };

    svg.addEventListener('pointerdown', (event) => {
      state.dragging = true;
      dot.classList.add('is-dragging');
      svg.setPointerCapture(event.pointerId);
      svg.focus();
      moveTo(event.clientX, event.clientY);
      event.preventDefault();
    });

    svg.addEventListener('pointermove', (event) => {
      if (state.dragging) moveTo(event.clientX, event.clientY);
    });

    const stop = () => {
      state.dragging = false;
      dot.classList.remove('is-dragging');
    };

    svg.addEventListener('pointerup', stop);
    svg.addEventListener('pointercancel', stop);

    svg.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? snap * 4 : snap;
      let handled = true;

      if (event.key === 'ArrowLeft') state.x -= step;
      else if (event.key === 'ArrowRight') state.x += step;
      else if (event.key === 'ArrowUp') state.y += step;
      else if (event.key === 'ArrowDown') state.y -= step;
      else handled = false;

      if (!handled) return;

      state.x = clamp(state.x, 0, maxX);
      state.y = clamp(state.y, 0, maxY);
      render(true);
      event.preventDefault();
    });

    (root as HTMLElement & { mcGetPoint?: () => { x: number; y: number } }).mcGetPoint = () => ({
      x: Number(state.x.toFixed(2)),
      y: Number(state.y.toFixed(2)),
    });

    render();
  });
</script>
